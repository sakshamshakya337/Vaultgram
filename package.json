{
  "name": "streamvault",
  "version": "1.0.0",
  "private": true,
  "description": "StreamVault — TikTok/Reels Style Cloud Video Vault powered by Telegram & MongoDB",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -n \"SERVER,WEB-PWA\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run web\"",
    "dev:server": "nodemon server.js",
    "dev:web": "npm --prefix web run dev",
    "dev:drive": "vite",
    "dev:all": "concurrently -n \"SERVER,WEB-PWA,DRIVE\" -c \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" \"npm run server\" \"npm run web\" \"npm run dev:drive\"",
    "server": "nodemon server.js",
    "web": "npm --prefix web run dev",
    "drive": "vite",
    "build": "npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "build:drive": "vite build",
    "build:all": "npm run build:drive && npm run build:web",
    "install:all": "npm install && npm --prefix web install",
    "start": "node server.js",
    "preview": "npm --prefix web run preview"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "autoprefixer": "^10.5.4",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "framer-motion": "^11.18.2",
    "heic-convert": "^2.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "mongoose": "^8.4.4",
    "multer": "^2.0.0",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
