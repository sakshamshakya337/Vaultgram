{
  "name": "personal-storage",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Storage — Private Cloud Vault powered by Telegram & MongoDB",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "vite",
    "dev:web": "npm --prefix web run dev",
    "build": "vite build",
    "build:web": "npm --prefix web run build",
    "start": "node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.5.4",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "form-data": "^4.0.0",
    "framer-motion": "^11.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "mongoose": "^8.4.4",
    "multer": "^2.0.0",
    "postcss": "^8.5.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  }
}
