{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://vaultgram.onrender.com/api/$1"
    },
    {
      "source": "/stream/(.*)",
      "destination": "https://vaultgram.onrender.com/stream/$1"
    },
    {
      "source": "/health",
      "destination": "https://vaultgram.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
