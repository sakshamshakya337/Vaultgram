# ─── Telegram Cloud Storage ───────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Channel ID or Group ID where files are stored (e.g., -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=-1001234567890

# ─── MongoDB Database ────────────────────────────────────────────────────────
# MongoDB connection URI (e.g., Atlas cluster or local MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/personal_storage?retryWrites=true&w=majority

# ─── Authentication (JWT) ────────────────────────────────────────────────────
# Strong random secret key for signing auth tokens
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# ─── Server & CORS Configuration ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Allowed origins for CORS (comma-separated list, e.g. https://streamvault.vercel.app,http://localhost:3000 or * for wildcard)
ALLOWED_ORIGIN=*

# ─── WebAuthn (Biometrics: Fingerprint / Face ID) ───────────────────────────
# WebAuthn RP ID must match the frontend domain (NOT backend). E.g. vaultgram-two.vercel.app or localhost
WEBAUTHN_RP_ID=vaultgram-two.vercel.app

# ─── Video Compression & Processing ──────────────────────────────────────────
# Max raw incoming upload file size before server rejection (in MB)
MAX_VIDEO_UPLOAD_SIZE_MB=200

# Max final stored video size limit (in MB)
MAX_COMPRESSED_VIDEO_SIZE_MB=20

# Target compression size for first encoding pass (in MB, safe margin below 20MB)
TARGET_VIDEO_SIZE_MB=19.0

# Max video duration allowed for processing in seconds (e.g. 600s = 10 minutes)
MAX_VIDEO_DURATION_SECONDS=600


